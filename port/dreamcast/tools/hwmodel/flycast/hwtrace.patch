+static void SetMemoryHandlersBase();
+
+// hwtrace wrappers (interpreter only)
+static ReadMem8Func o_r8; static ReadMem16Func o_r16; static ReadMem32Func o_r32; static ReadMem64Func o_r64;
+static WriteMem8Func o_w8; static WriteMem16Func o_w16; static WriteMem32Func o_w32; static WriteMem64Func o_w64;
+static u8 DYNACALL t_r8(u32 a) { if (hwtrace::tracing) hwtrace::event(a, 2, 0); return o_r8(a); }
+static u16 DYNACALL t_r16(u32 a) { if (hwtrace::tracing) hwtrace::event(a, 2, 1); return o_r16(a); }
+static u32 DYNACALL t_r32(u32 a) { if (hwtrace::tracing) hwtrace::event(a, 2, 2); return o_r32(a); }
+static u64 DYNACALL t_r64(u32 a) { if (hwtrace::tracing) hwtrace::event(a, 2, 3); return o_r64(a); }
+static void DYNACALL t_w8(u32 a, u8 d) { if (hwtrace::tracing) hwtrace::event(a, 3, 0); o_w8(a, d); }
+static void DYNACALL t_w16(u32 a, u16 d) { if (hwtrace::tracing) hwtrace::event(a, 3, 1); o_w16(a, d); }
+static void DYNACALL t_w32(u32 a, u32 d) {
+	if (hwtrace::tracing) hwtrace::event(a, 3, 2);
+	o_w32(a, d);
+	if ((a & 0x1fffffff) == hwtrace::frameAddr) hwtrace::frameWrite(d);
+}
+static void DYNACALL t_w64(u32 a, u64 d) { if (hwtrace::tracing) hwtrace::event(a, 3, 3); o_w64(a, d); }
+
 void SetMemoryHandlers()
+{
+	SetMemoryHandlersBase();
+	if (!hwtrace::enabled || config::DynarecEnabled)
+		return;
+	o_r8 = ReadMem8; o_r16 = ReadMem16; o_r32 = ReadMem32; o_r64 = ReadMem64;
+	o_w8 = WriteMem8; o_w16 = WriteMem16; o_w32 = WriteMem32; o_w64 = WriteMem64;
+	ReadMem8 = &t_r8; ReadMem16 = &t_r16; ReadMem32 = &t_r32; ReadMem64 = &t_r64;
+	WriteMem8 = &t_w8; WriteMem16 = &t_w16; WriteMem32 = &t_w32; WriteMem64 = &t_w64;
+}
+
+static void SetMemoryHandlersBase()
 {
 #ifdef STRICT_MODE
 	static bool interpreterRunning;
