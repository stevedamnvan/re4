diff --git a/core/hw/sh4/interpr/hwtrace.h b/core/hw/sh4/interpr/hwtrace.h
new file mode 100644
index 0000000..5f8b38e
--- /dev/null
+++ b/core/hw/sh4/interpr/hwtrace.h
@@ -0,0 +1,53 @@
+/*
+	hwtrace: interpreter-only SH-4 address/instruction trace for offline cache and
+	pipeline modelling (RE4DC D367 hwmodel). Inactive unless HWTRACE_DIR is set
+	and the dynarec is disabled. Never changes guest-visible behaviour.
+
+	Env:
+	  HWTRACE_DIR        output directory (required to enable)
+	  HWTRACE_FRAMEADDR  physical address of the guest frame-marker word (hex);
+	                     a 32-bit store of value V there means "frame V ended"
+	  HWTRACE_COUNT      A:B  per-PC execution counts for frames A..B
+	  HWTRACE_TRACE      A:B:S full trace of frames A, A+S, ... <= B
+	  HWTRACE_EXIT       1: terminate the emulator after the last window frame
+
+	Trace file trace-<frame>.bin: little-endian u32 pairs (w0, w1)
+	  w1 >> 28 == 1: RUN   w0 = start pc, w1 & 0x0fffffff = sequential instruction count
+	  otherwise  : EVENT w0 = address, w1 = type<<28 | sizecode<<24 | (pc>>1 & 0xffffff)
+	      type 2 read, 3 write, 4 pref, 5 ocbi, 6 ocbp, 7 ocbwb, 8 movca.l write,
+	      9 store-queue flush (pref to 0xe0000000), 10 sleep,
+	      11 DMA start (w0 = RAM address, sizecode = kind), always followed by
+	      12 DMA length (w0 = bytes)
+	      sizecode 0..3 = 1, 2, 4, 8 bytes
+	  Events belong to the run that is flushed after them (runs are written when
+	  they end), in program order.
+*/
+#pragma once
+#include "types.h"
+
+namespace hwtrace
+{
+extern bool enabled;
+extern bool tracing;
+extern bool counting;
+extern u32 frameAddr;
+extern u32 curPc;
+extern bool movca;
+extern u64 insns;
+
+void init();
+void fetchSlow(u32 pc);
+void event(u32 addr, u32 type, u32 sizecode);
+void frameWrite(u32 value);
+void op(u16 op, u32 rn);
+// DMA from/to system RAM started by hardware (kind: 1 ch2 TA, 2 ch2 texture, 3 PVR-DMA, 4 G2/AICA, 5 GD-ROM)
+void dma(u32 ramAddr, u32 len, u32 kind);
+
+static inline void fetch(u32 pc)
+{
+	curPc = pc;
+	insns++;
+	if (tracing || counting)
+		fetchSlow(pc);
+}
+}
