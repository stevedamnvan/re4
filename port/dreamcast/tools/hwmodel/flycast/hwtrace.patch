+
+// ---------------------------------------------------------------------------
+// hwtrace (RE4DC D367 hwmodel): see hwtrace.h
+// ---------------------------------------------------------------------------
+namespace hwtrace
+{
+bool enabled;
+bool tracing;
+bool counting;
+bool movca;
+u32 frameAddr = 0xffffffff;
+u32 curPc;
+u64 insns;
+
+static std::string dir;
+static u32 cntA = 1, cntB = 0, trA = 1, trB = 0, trS = 1;
+static bool exitAfter;
+static FILE *logf;
+static FILE *tf;
+static std::vector<u32> buf;
+static u32 *counts;
+static u32 runStart, runCount;
+static u64 frameInsns, frameCycles, winInsns;
+static u32 tracedFrames;
+
+static void flushBuf()
+{
+	if (tf != nullptr && !buf.empty())
+		fwrite(buf.data(), 4, buf.size(), tf);
+	buf.clear();
+}
+
+static inline void push(u32 a, u32 b)
+{
+	buf.push_back(a);
+	buf.push_back(b);
+	if (buf.size() >= (16u << 20))
+		flushBuf();
+}
+
+static void flushRun()
+{
+	if (runCount != 0)
+		push(runStart, 0x10000000u | runCount);
+	runCount = 0;
+}
+
+void init()
+{
+	const char *d = getenv("HWTRACE_DIR");
+	if (d == nullptr || *d == 0 || config::DynarecEnabled)
+		return;
+	dir = d;
+	if (const char *s = getenv("HWTRACE_FRAMEADDR"))
+		frameAddr = (u32)strtoul(s, nullptr, 16) & 0x1fffffff;
+	if (const char *s = getenv("HWTRACE_COUNT"))
+		sscanf(s, "%u:%u", &cntA, &cntB);
+	if (const char *s = getenv("HWTRACE_TRACE"))
+		sscanf(s, "%u:%u:%u", &trA, &trB, &trS);
+	if (trS == 0)
+		trS = 1;
+	if (const char *s = getenv("HWTRACE_EXIT"))
+		exitAfter = atoi(s) != 0;
+	logf = fopen((dir + "/hwtrace.log").c_str(), "a");
+	if (logf != nullptr)
+	{
+		fprintf(logf, "hwtrace init frameaddr=%08x count=%u:%u trace=%u:%u:%u exit=%d\n",
+				frameAddr, cntA, cntB, trA, trB, trS, (int)exitAfter);
+		fflush(logf);
+	}
+	counts = (u32 *)calloc(1u << 23, 4);
+	buf.reserve((16u << 20) + 16);
+	enabled = true;
+}
+
+void fetchSlow(u32 pc)
+{
+	if (counting && (pc & 0x1C000000) == 0x0C000000)
+		counts[(pc & 0xFFFFFF) >> 1]++;
+	if (tracing)
+	{
+		if (runCount != 0 && pc == runStart + 2 * runCount && runCount < 0x0FFFFFFF)
+			runCount++;
+		else
+		{
+			flushRun();
+			runStart = pc;
+			runCount = 1;
+		}
+	}
+}
+
+void event(u32 addr, u32 type, u32 sizecode)
+{
+	if (movca && type == 3)
+		type = 8;
+	push(addr, (type << 28) | (sizecode << 24) | ((curPc >> 1) & 0xFFFFFF));
+}
+
+void op(u16 op, u32 rn)
+{
+	if (op == 0x001B)
+	{
+		event(0, 10, 0);
+		return;
+	}
+	switch (op & 0x00F0)
+	{
+	case 0x80:
+		event(rn, (rn >> 26) == 0x38 ? 9 : 4, 3);
+		break;
+	case 0x90: event(rn, 5, 3); break;
+	case 0xA0: event(rn, 6, 3); break;
+	case 0xB0: event(rn, 7, 3); break;
+	case 0xC0: movca = true; break;
+	default: break;
+	}
+}
+
+void dma(u32 ramAddr, u32 len, u32 kind)
+{
+	if (!tracing)
+		return;
+	const u32 pc = (curPc >> 1) & 0xFFFFFF;
+	push(ramAddr, (11u << 28) | ((kind & 15) << 24) | pc);
+	push(len, (12u << 28) | pc);
+}
+
+void frameWrite(u32 v)
+{
+	if (!enabled)
+		return;
+	const u64 now = sh4_sched_now64();
+	const u32 cur = v + 1;
+	if (logf != nullptr)
+		fprintf(logf, "frame %u insns %llu cycles %llu%s%s\n", v, (unsigned long long)(insns - frameInsns),
+				(unsigned long long)(now - frameCycles), counting ? " counted" : "", tracing ? " traced" : "");
+	if (counting)
+		winInsns += insns - frameInsns;
+	frameInsns = insns;
+	frameCycles = now;
+	if (tracing)
+	{
+		flushRun();
+		flushBuf();
+		fclose(tf);
+		tf = nullptr;
+		tracing = false;
+		tracedFrames++;
+	}
+	if (counting && v >= cntB)
+	{
+		counting = false;
+		FILE *cf = fopen((dir + "/counts.bin").c_str(), "wb");
+		if (cf != nullptr)
+		{
+			fwrite(counts, 4, 1u << 23, cf);
+			fclose(cf);
+		}
+		if (logf != nullptr)
+			fprintf(logf, "counts written frames %u:%u insns %llu\n", cntA, cntB, (unsigned long long)winInsns);
+	}
+	if (cur >= cntA && cur <= cntB)
+		counting = true;
+	if (cur >= trA && cur <= trB && (cur - trA) % trS == 0)
+	{
+		char name[64];
+		snprintf(name, sizeof(name), "/trace-%05u.bin", cur);
+		tf = fopen((dir + name).c_str(), "wb");
+		if (tf != nullptr)
+		{
+			tracing = true;
+			runCount = 0;
+			buf.clear();
+		}
+	}
+	if (logf != nullptr)
+		fflush(logf);
+	if (exitAfter && v >= cntB && v >= trB)
+	{
+		if (logf != nullptr)
+		{
+			fprintf(logf, "hwtrace done: traced %u frames; exiting\n", tracedFrames);
+			fclose(logf);
+		}
+		std::_Exit(0);
+	}
+}
+}	// namespace hwtrace
