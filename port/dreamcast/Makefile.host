REPO_ROOT := ../..
BUILD := build/host
CXX ?= g++
CXXFLAGS ?= -std=c++20 -O2 -g -Wall -Wextra -Werror -pedantic
PYTHON ?= python3
R10D_OBJ ?= $(REPO_ROOT)/orig/G4BE08/rooms/r10d/r10d/r10d_004.scenario.obj
R10D_MTL ?= $(REPO_ROOT)/orig/G4BE08/rooms/r10d/r10d/r10d_004.scenario.mtl
R10D_TPL ?= $(REPO_ROOT)/orig/G4BE08/rooms/r10d/r10d/r10d_004.TPL
R10D_SAT_SOURCE ?= $(REPO_ROOT)/orig/G4BE08/rooms/r10d/r10d/r10d_001.SAT
R10D_ROOM ?= build/private/r10d.re4room
R10D_SAT ?= build/private/r10d.re4sat
R10D_TEXTURE ?= build/private/r10d.re4tex
R100_RTP_SOURCE ?= $(REPO_ROOT)/orig/G4BE08/rooms/r100/r100/r100_017.RTP
R100_RTP ?= build/private/r100.re4rtp
R100_SAT_SOURCE ?= $(REPO_ROOT)/orig/G4BE08/rooms/r100/r100/r100_001.SAT
R100_SAT ?= build/private/r100-meters.re4sat
R100_EXPORT_DIR ?= $(REPO_ROOT)/orig/G4BE08/rooms/r100/stream/r100_full_export
R100_OBJ ?= $(R100_EXPORT_DIR)/R100.encounter-radius180.obj
R100_SMX ?= $(REPO_ROOT)/orig/G4BE08/rooms/r100/r100/r100_006.SMX
R100_ROOM ?= build/private/r100-encounter-source-meters-smx.re4room
R100_PRODUCTION_ROOM ?= build/private/r100-source-cell-4.re4room
R100_PRODUCTION_CELL_SIZE ?= 4
SOURCE_HUD_CORE ?= build/private/core/core.das
SOURCE_HUD_LAYOUT ?= build/private/source-hud.re4hud
SOURCE_HUD_TEXTURE ?= build/private/source-hud.re4tex
SOURCE_HUD_TWIDDLE ?= 1
SOURCE_HUD_TWIDDLE_ARG := $(if $(SOURCE_HUD_TWIDDLE),--twiddle,)
R100_TPL ?= $(R100_EXPORT_DIR)/R100.TPL.TPL
R100_MTL ?= $(R100_EXPORT_DIR)/R100.allparts.mtl
R100_TEXTURE ?= build/private/r100-entry-source.re4tex
R100_TEXTURE_MAX_DIMENSION ?= 256
# R4b: payloads are written in the PVR's order at build time, so the
# runtime copies them straight into texture memory.
R100_TEXTURE_TWIDDLE ?= 1
R100_TEXTURE_TWIDDLE_ARG := $(if $(R100_TEXTURE_TWIDDLE),--twiddle,)
R100_UNPARTITIONED_MATERIALS := ROOM_MATERIAL_002 ROOM_MATERIAL_003 \
	ROOM_MATERIAL_004 ROOM_MATERIAL_005 ROOM_MATERIAL_008 ROOM_MATERIAL_009 \
	ROOM_MATERIAL_014 ROOM_MATERIAL_015 ROOM_MATERIAL_016 ROOM_MATERIAL_027 \
	ROOM_MATERIAL_028 ROOM_MATERIAL_035 ROOM_MATERIAL_043
R100_UNPARTITIONED_ARGS := $(foreach material,$(R100_UNPARTITIONED_MATERIALS),--unpartitioned-material $(material))
R10D_CELL_SIZE ?= 20
R10D_CLUSTER_SIZE ?= 0
R101_DIR ?= $(REPO_ROOT)/orig/G4BE08/rooms/r101/r101
R101_OBJ ?= $(R101_DIR)/r101_004.scenario.obj
R101_MTL ?= $(R101_DIR)/r101_004.scenario.mtl
# Embedded inside the scenario SMD rather than shipped as its own chunk, which
# is why r101 looked texture-poor when only the standalone TPL chunks were
# counted.
R101_TPL ?= $(R101_DIR)/r101_004.TPL
R101_SMX ?= $(R101_DIR)/r101_005.SMX
R101_SMD ?= $(R101_DIR)/r101_004.SMD
R101_LIT ?= $(R101_DIR)/r101_002.LIT
R101_SAT_SOURCE ?= $(R101_DIR)/r101_001.SAT
R101_RTP_SOURCE ?= $(R101_DIR)/r101_016.RTP
R101_ROOM ?= build/private/r101-source-cell-4.re4room
R101_SAT ?= build/private/r101-meters.re4sat
R101_RTP ?= build/private/r101.re4rtp
R101_TEXTURE ?= build/private/r101-source.re4tex
R101_CELL_SIZE ?= 4
R101_TEXTURE_MAX_DIMENSION ?= 256

R100_LIT ?= $(REPO_ROOT)/orig/G4BE08/rooms/r100/r100/r100_002.LIT
RE4_DISC ?= $(REPO_ROOT)/orig/G4BE08/re4_debug_disc1.iso
DTK ?= $(REPO_ROOT)/build/tools/dtk
SOURCE_AUDIO_DIR ?= build/private/source-audio
SOURCE_ENEMY_AUDIO_DIR ?= build/private/source-enemy-audio
SOURCE_PLAYER_AUDIO_DIR ?= build/private/source-player-audio
LEON_CHARACTER ?= build/private/leon.re4chr
GANADO_CHARACTER ?= build/private/ganado.re4chr
CHARACTER_CLUSTER_MM ?= 0
CHARACTER_TEXTURE_MAX_DIMENSION ?=
CHARACTER_SAMPLE_STEP ?= 4
CHARACTER_TEXTURE_MAX_ARG := $(if $(CHARACTER_TEXTURE_MAX_DIMENSION),--texture-max-dimension $(CHARACTER_TEXTURE_MAX_DIMENSION),)
CHARACTER_TWIDDLE ?=
CHARACTER_TWIDDLE_ARG := $(if $(CHARACTER_TWIDDLE),--twiddle-textures,)

.PHONY: all test audit motion-host motion-cross-host motion-real-host room-r10d room-r100-source room-r100-production room-r100-production-compat lit-r100 lit-r101 room-r101 room-r101-source collision-r101-source route-r101 texture-r101-source collision-r100-source route-r100 texture-r10d texture-r100-production asset-residency-r100 hud-source character-leon character-ganado characters-r100 source-weapon-audio source-enemy-audio source-player-audio demo-r10d script-check unit clean

all: $(BUILD)/abi_probe

$(BUILD)/abi_probe: src/abi_probe.cpp include/re4dc/abi.hpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude src/abi_probe.cpp -o $@

audit:
	@mkdir -p $(BUILD)
	$(PYTHON) tools/portability_audit.py $(REPO_ROOT) --json $(BUILD)/portability-audit.json

unit:
	$(PYTHON) -m unittest discover -s tests -v

motion-host:
	$(MAKE) -C $(REPO_ROOT)/tools/motion/host

motion-cross-host:
	$(MAKE) -C motion -f Makefile.host run

motion-real-host:
	$(MAKE) -C motion -f Makefile.host real-run

room-r10d:
	$(PYTHON) tools/convert_room_obj.py --cell-size $(R10D_CELL_SIZE) \
		--cluster-size $(R10D_CLUSTER_SIZE) $(R10D_OBJ) $(R10D_ROOM)
	$(PYTHON) tools/convert_sat.py $(R10D_SAT_SOURCE) $(R10D_SAT)

room-r100-source:
	$(PYTHON) tools/convert_room_obj.py --source-scale 0.1 \
		--smx $(R100_SMX) \
		--smd MAINSCENARIO=$(R100_EXPORT_DIR)/r100_004.SMD \
		--smd FILE_00=$(R100_EXPORT_DIR)/r100_00_000.SMD \
		--smd FILE_01=$(R100_EXPORT_DIR)/r100_01_000.SMD \
		--smd FILE_02=$(R100_EXPORT_DIR)/r100_02_000.SMD \
		--common-smd $(R100_EXPORT_DIR)/r100_005.SMD \
		--source-unit-scale 0.001 $(R100_OBJ) $(R100_ROOM)

room-r100-production:
	$(PYTHON) tools/convert_room_obj.py --source-scale 0.1 \
		--cell-size $(R100_PRODUCTION_CELL_SIZE) \
		$(R100_UNPARTITIONED_ARGS) \
		--smx $(R100_SMX) \
		--smd MAINSCENARIO=$(R100_EXPORT_DIR)/r100_004.SMD \
		--smd FILE_00=$(R100_EXPORT_DIR)/r100_00_000.SMD \
		--smd FILE_01=$(R100_EXPORT_DIR)/r100_01_000.SMD \
		--smd FILE_02=$(R100_EXPORT_DIR)/r100_02_000.SMD \
		--common-smd $(R100_EXPORT_DIR)/r100_005.SMD \
		--source-unit-scale 0.001 $(R100_OBJ) $(R100_PRODUCTION_ROOM)

# A room's authored lighting environment: fog, background, ambient and the light
# table for a cut, read from its .LIT rather than transcribed by hand. Verified
# by regenerating r100's, which reproduces the constants in main.cpp.
lit-r100:
	$(PYTHON) tools/convert_lit.py \
		$(R100_LIT) --name R100 --header build/private/r100_lit.hpp

lit-r101:
	$(PYTHON) tools/convert_lit.py \
		$(R101_LIT) --name R101 --header build/private/r101_lit.hpp

# The accepted layout, every batch carrying both a triangle range and strips,
# kept available so the one-representation package can be compared against it.
room-r100-production-compat:
	$(PYTHON) tools/convert_room_obj.py --source-scale 0.1 		--cell-size $(R100_PRODUCTION_CELL_SIZE) 		--keep-triangle-indices 		$(R100_UNPARTITIONED_ARGS) 		--smx $(R100_SMX) 		--smd MAINSCENARIO=$(R100_EXPORT_DIR)/r100_004.SMD 		--smd FILE_00=$(R100_EXPORT_DIR)/r100_00_000.SMD 		--smd FILE_01=$(R100_EXPORT_DIR)/r100_01_000.SMD 		--smd FILE_02=$(R100_EXPORT_DIR)/r100_02_000.SMD 		--common-smd $(R100_EXPORT_DIR)/r100_005.SMD 		--source-unit-scale 0.001 $(R100_OBJ) 		build/private/r100-source-cell-4-both.re4room

# r101, r100's only authored neighbour. Same converters, same settings, no
# r100-specific overrides.
room-r101-source:
	$(PYTHON) tools/convert_room_obj.py --source-scale 0.1 \
		--cell-size $(R101_CELL_SIZE) \
		--smx $(R101_SMX) \
		--smd GGSCENARIO=$(R101_SMD) \
		--source-unit-scale 0.001 $(R101_OBJ) $(R101_ROOM)

collision-r101-source:
	$(PYTHON) tools/convert_sat.py --source-scale 0.001 \
		$(R101_SAT_SOURCE) $(R101_SAT)

route-r101:
	$(PYTHON) tools/convert_rtp.py $(R101_RTP_SOURCE) $(R101_RTP)

texture-r101-source:
	$(PYTHON) tools/convert_tpl.py \
		--max-dimension $(R101_TEXTURE_MAX_DIMENSION) $(R100_TEXTURE_TWIDDLE_ARG) \
		$(R101_TPL) $(R101_MTL) $(R101_TEXTURE)

room-r101: room-r101-source collision-r101-source route-r101 texture-r101-source

collision-r100-source:
	$(PYTHON) tools/convert_sat.py --source-scale 0.001 \
		$(R100_SAT_SOURCE) $(R100_SAT)

route-r100:
	$(PYTHON) tools/convert_rtp.py $(R100_RTP_SOURCE) $(R100_RTP)

texture-r10d:
	$(PYTHON) tools/convert_tpl.py $(R10D_TPL) $(R10D_MTL) $(R10D_TEXTURE)

# Reproduces the accepted r100 texture package. The 256-pixel limit is the one
# the accepted package was built with; it is a source-asset reduction and is
# recorded as such in the asset residency report.
texture-r100-production:
	$(PYTHON) tools/convert_tpl.py 		--max-dimension $(R100_TEXTURE_MAX_DIMENSION) $(R100_TEXTURE_TWIDDLE_ARG) 		$(R100_TPL) $(R100_MTL) $(R100_TEXTURE)

# The HUD layout and textures the r100 build consumes. core.das is extracted
# from the private disc; this rule converts it and is otherwise deterministic.
hud-source:
	$(PYTHON) tools/convert_core_hud.py 		$(SOURCE_HUD_CORE) $(SOURCE_HUD_LAYOUT) $(SOURCE_HUD_TEXTURE) 		--manifest build/private/source-hud.json $(SOURCE_HUD_TWIDDLE_ARG)

# R4 deliverable 1. Reports every r100 texture's GameCube source, the
# representation the accepted package ships, and each Dreamcast candidate with
# its exact VRAM cost. Reads private assets and writes only a report.
asset-residency-r100:
	$(PYTHON) tools/asset_residency_report.py 		--tpl $(R100_TPL) --mtl $(R100_MTL) 		--package $(R100_TEXTURE) 		--max-dimension $(R100_TEXTURE_MAX_DIMENSION) 		--json build/private/r100-residency.json

character-leon:
	# PL_ARC_PTR numbers include the four-word DRS body header: source
	# hit-left 0x4a and death 0x4c are archive entries 70 and 72.
	$(PYTHON) tools/convert_character.py --source $(RE4_DISC) \
		--cache-dir build/private/disc-cache --model-archive pl00.drs --model-entry 0 \
		--attachment costume:pl00.drs:6:1 \
		--attachment head:pl00.drs:4:3 \
		--attachment hair:pl00.drs:2:3 \
		--attachment eyes:pl00.drs:5:3 \
		--attachment right-hand:wep02.drs:6:pl00.drs:13 \
		--attachment left-hand:pl00.drs:20:13 \
		--rigid-attachment handgun:wep02.drs:2:1:10 \
		--rigid-marker gun-muzzle:10:0:0:0:0:234.5:-24:38.33 \
		--rigid-marker gun-minus-x:10:0:0:0:0:-265.5:-24:38.33 \
		--rigid-marker gun-plus-y:10:0:0:0:0:234.5:476:38.33 \
		--rigid-marker gun-plus-z:10:0:0:0:0:234.5:-24:538.33 \
		--rigid-marker pl-hit0-bottom:1:0:0:0:0:0:-30:0 \
		--rigid-marker pl-hit0-top:1:0:0:0:0:0:70:0 \
		--rigid-marker pl-hit1-bottom:2:0:0:0:0:0:0:0 \
		--rigid-marker pl-hit1-top:2:0:0:0:0:0:130:0 \
		--rigid-marker pl-hit2-bottom:4:0:0:0:0:0:0:0 \
		--rigid-marker pl-hit2-top:4:0:0:0:0:0:80:0 \
		--rigid-marker pl-hit3-bottom:18:0:0:0:0:-20:-300:0 \
		--rigid-marker pl-hit3-top:18:0:0:0:0:-20:0:0 \
		--rigid-marker pl-hit4-bottom:22:0:0:0:0:20:-300:0 \
		--rigid-marker pl-hit4-top:22:0:0:0:0:20:0:0 \
		--clip idle:wep02.drs:7 --clip walk:wep02.drs:13 \
		--clip aim-positive:wep02.drs:38:16 --clip aim-level:wep02.drs:39 \
		--clip aim-negative:wep02.drs:40:16 \
		--clip fire-positive:wep02.drs:41:16 --clip fire-level:wep02.drs:42 \
		--clip fire-negative:wep02.drs:43:16 \
		--clip reload:wep02.drs:45 --clip hit-left:pl00.drs:70 \
		--clip death:pl00.drs:72 \
		--sample-step $(CHARACTER_SAMPLE_STEP) --cluster-mm $(CHARACTER_CLUSTER_MM) \
		--quantum-mm 0.125 \
		$(CHARACTER_TEXTURE_MAX_ARG) $(CHARACTER_TWIDDLE_ARG) \
		--output $(LEON_CHARACTER)

character-ganado:
	$(PYTHON) tools/convert_character.py --source $(RE4_DISC) \
		--cache-dir build/private/disc-cache --model-archive em12.drs --model-entry 440 \
		--attachment head:em12.drs:442:441 \
		--attachment right-hand:em12.drs:447:441 \
		--attachment left-hand:em12.drs:449:441 \
		--rigid-attachment hatchet:em12.drs:616:617:10:-313.85:-21.2:102.21:-1.0402162 \
		--rigid-marker em-hit0-bottom:4:0:0:0:0:0:0:0 \
		--rigid-marker em-hit0-top:4:0:0:0:0:0:110:0 \
		--rigid-marker em-hit1-bottom:1:0:0:0:0:0:-30:0 \
		--rigid-marker em-hit1-top:1:0:0:0:0:0:260:0 \
		--rigid-marker em-hit2-bottom:19:0:0:0:0:-20:-400:0 \
		--rigid-marker em-hit2-top:19:0:0:0:0:-20:0:0 \
		--rigid-marker em-hit3-bottom:23:0:0:0:0:20:-400:0 \
		--rigid-marker em-hit3-top:23:0:0:0:0:20:0:0 \
		--rigid-marker em-hit4-bottom:8:0:0:0:0:-350:0:0 \
		--rigid-marker em-hit4-top:8:0:0:0:0:0:0:0 \
		--rigid-marker em-hit5-bottom:14:0:0:0:0:0:0:0 \
		--rigid-marker em-hit5-top:14:0:0:0:0:350:0:0 \
		--rigid-marker em-hit6-bottom:18:0:0:0:0:-20:-300:0 \
		--rigid-marker em-hit6-top:18:0:0:0:0:-20:0:0 \
		--rigid-marker em-hit7-bottom:22:0:0:0:0:20:-300:0 \
		--rigid-marker em-hit7-top:22:0:0:0:0:20:0:0 \
		--rigid-marker em-hit8-bottom:7:0:0:0:0:-300:0:0 \
		--rigid-marker em-hit8-top:7:0:0:0:0:0:0:0 \
		--rigid-marker em-hit9-bottom:13:0:0:0:0:0:0:0 \
		--rigid-marker em-hit9-top:13:0:0:0:0:300:0:0 \
		--rigid-marker axe-base:10:-313.85:-21.2:102.21:-1.0402162:0:0:-1000 \
		--rigid-marker axe-low:10:-313.85:-21.2:102.21:-1.0402162:0:0:-200 \
		--rigid-marker axe-high:10:-313.85:-21.2:102.21:-1.0402162:0:0:50 \
		--clip idle:em12.drs:1 --clip walk:em12.drs:4 \
		--clip attack:em12.drs:128 --clip hit:em12.drs:38 \
		--clip death:em12.drs:103 --sample-step 2 \
		--cluster-mm $(CHARACTER_CLUSTER_MM) --quantum-mm 0.125 \
		$(CHARACTER_TEXTURE_MAX_ARG) $(CHARACTER_TWIDDLE_ARG) \
		--output $(GANADO_CHARACTER)

characters-r100:
	$(MAKE) -f Makefile.host character-leon \
		LEON_CHARACTER=build/private/leon-source-r100-gunhitcaps-pitch.re4chr \
		CHARACTER_TEXTURE_MAX_DIMENSION=128 		CHARACTER_TWIDDLE=1
	$(MAKE) -f Makefile.host character-ganado \
		GANADO_CHARACTER=build/private/ganado-source-r100-hitcaps.re4chr \
		CHARACTER_TEXTURE_MAX_DIMENSION=128 		CHARACTER_TWIDDLE=1

source-weapon-audio:
	@mkdir -p $(SOURCE_AUDIO_DIR)
	$(DTK) vfs cp $(RE4_DISC):/files/em/wep02.drs $(SOURCE_AUDIO_DIR)/wep02.drs
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_AUDIO_DIR)/wep02.drs 0 $(SOURCE_AUDIO_DIR)/wep02-cue00.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_AUDIO_DIR)/wep02.drs 2 $(SOURCE_AUDIO_DIR)/wep02-cue02.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_AUDIO_DIR)/wep02.drs 0x16 $(SOURCE_AUDIO_DIR)/wep02-cue16.wav

source-enemy-audio:
	@mkdir -p $(SOURCE_ENEMY_AUDIO_DIR)
	$(DTK) vfs cp $(RE4_DISC):/files/em/em12.drs $(SOURCE_ENEMY_AUDIO_DIR)/em12.drs
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_ENEMY_AUDIO_DIR)/em12.drs 0x3d $(SOURCE_ENEMY_AUDIO_DIR)/em12-cue3d.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_ENEMY_AUDIO_DIR)/em12.drs 0x0c $(SOURCE_ENEMY_AUDIO_DIR)/em12-body-hit-0c.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_ENEMY_AUDIO_DIR)/em12.drs 0x47 $(SOURCE_ENEMY_AUDIO_DIR)/em12-damage-voice-47.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_ENEMY_AUDIO_DIR)/em12.drs 0x16 $(SOURCE_ENEMY_AUDIO_DIR)/em12-death-voice-16.wav

source-player-audio:
	@mkdir -p $(SOURCE_PLAYER_AUDIO_DIR)
	$(DTK) vfs cp $(RE4_DISC):/files/em/pl00.drs $(SOURCE_PLAYER_AUDIO_DIR)/pl00.drs
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_PLAYER_AUDIO_DIR)/pl00.drs 9 $(SOURCE_PLAYER_AUDIO_DIR)/pl00-cue09.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_PLAYER_AUDIO_DIR)/pl00.drs 10 $(SOURCE_PLAYER_AUDIO_DIR)/pl00-cue10.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_PLAYER_AUDIO_DIR)/pl00.drs 11 $(SOURCE_PLAYER_AUDIO_DIR)/pl00-cue11.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_PLAYER_AUDIO_DIR)/pl00.drs 13 $(SOURCE_PLAYER_AUDIO_DIR)/pl00-cue13.wav

demo-r10d: room-r10d texture-r10d character-leon character-ganado source-weapon-audio source-enemy-audio source-player-audio

script-check:
	bash -n kos-env.sh tools/bootstrap_kos.sh

test: all audit motion-host motion-cross-host script-check unit
	$(BUILD)/abi_probe > $(BUILD)/abi-probe.json
	@printf 'Host baseline written to %s\n' '$(BUILD)'

clean:
	rm -rf $(BUILD)
