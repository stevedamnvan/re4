REPO_ROOT := ../..
BUILD := build/host
CXX ?= g++
CXXFLAGS ?= -std=c++20 -O2 -g -Wall -Wextra -Werror -pedantic
PYTHON ?= python3
R10D_OBJ ?= $(REPO_ROOT)/orig/G4BE08/rooms/r10d/r10d/r10d_004.scenario.obj
R10D_MTL ?= $(REPO_ROOT)/orig/G4BE08/rooms/r10d/r10d/r10d_004.scenario.mtl
R10D_TPL ?= $(REPO_ROOT)/orig/G4BE08/rooms/r10d/r10d/r10d_004.TPL
R10D_SAT_SOURCE ?= $(REPO_ROOT)/orig/G4BE08/rooms/r10d/r10d/r10d_001.SAT
R10D_ROOM ?= build/private/r10d.re4room
R10D_SAT ?= build/private/r10d.re4sat
R10D_TEXTURE ?= build/private/r10d.re4tex
R100_RTP_SOURCE ?= $(REPO_ROOT)/orig/G4BE08/rooms/r100/r100/r100_017.RTP
R100_RTP ?= build/private/r100.re4rtp
R10D_CELL_SIZE ?= 20
R10D_CLUSTER_SIZE ?= 0
RE4_DISC ?= $(REPO_ROOT)/orig/G4BE08/re4_debug_disc1.iso
DTK ?= $(REPO_ROOT)/build/tools/dtk
SOURCE_AUDIO_DIR ?= build/private/source-audio
SOURCE_ENEMY_AUDIO_DIR ?= build/private/source-enemy-audio
SOURCE_PLAYER_AUDIO_DIR ?= build/private/source-player-audio
LEON_CHARACTER ?= build/private/leon.re4chr
GANADO_CHARACTER ?= build/private/ganado.re4chr
CHARACTER_CLUSTER_MM ?= 0
CHARACTER_TEXTURE_MAX_DIMENSION ?=
CHARACTER_SAMPLE_STEP ?= 4
CHARACTER_TEXTURE_MAX_ARG := $(if $(CHARACTER_TEXTURE_MAX_DIMENSION),--texture-max-dimension $(CHARACTER_TEXTURE_MAX_DIMENSION),)

.PHONY: all test audit motion-host motion-cross-host motion-real-host room-r10d route-r100 texture-r10d character-leon character-ganado source-weapon-audio source-enemy-audio source-player-audio demo-r10d script-check unit clean

all: $(BUILD)/abi_probe

$(BUILD)/abi_probe: src/abi_probe.cpp include/re4dc/abi.hpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude src/abi_probe.cpp -o $@

audit:
	@mkdir -p $(BUILD)
	$(PYTHON) tools/portability_audit.py $(REPO_ROOT) --json $(BUILD)/portability-audit.json

unit:
	$(PYTHON) -m unittest discover -s tests -v

motion-host:
	$(MAKE) -C $(REPO_ROOT)/tools/motion/host

motion-cross-host:
	$(MAKE) -C motion -f Makefile.host run

motion-real-host:
	$(MAKE) -C motion -f Makefile.host real-run

room-r10d:
	$(PYTHON) tools/convert_room_obj.py --cell-size $(R10D_CELL_SIZE) \
		--cluster-size $(R10D_CLUSTER_SIZE) $(R10D_OBJ) $(R10D_ROOM)
	$(PYTHON) tools/convert_sat.py $(R10D_SAT_SOURCE) $(R10D_SAT)

route-r100:
	$(PYTHON) tools/convert_rtp.py $(R100_RTP_SOURCE) $(R100_RTP)

texture-r10d:
	$(PYTHON) tools/convert_tpl.py $(R10D_TPL) $(R10D_MTL) $(R10D_TEXTURE)

character-leon:
	# PL_ARC_PTR numbers include the four-word DRS body header: source
	# hit-left 0x4a and death 0x4c are archive entries 70 and 72.
	$(PYTHON) tools/convert_character.py --source $(RE4_DISC) \
		--cache-dir build/private/disc-cache --model-archive pl00.drs --model-entry 0 \
		--attachment costume:pl00.drs:6:1 \
		--attachment face:pl00.drs:9:1 \
		--attachment head:pl00.drs:4:3 \
		--attachment hair:pl00.drs:2:3 \
		--attachment eyes:pl00.drs:5:3 \
		--attachment right-hand:pl00.drs:14:13 \
		--attachment left-hand:pl00.drs:17:13 \
		--rigid-attachment handgun:wep02.drs:2:1:10 \
		--rigid-marker gun-muzzle:10:0:0:0:0:234.5:-24:38.33 \
		--rigid-marker gun-minus-x:10:0:0:0:0:-265.5:-24:38.33 \
		--rigid-marker gun-plus-y:10:0:0:0:0:234.5:476:38.33 \
		--rigid-marker gun-plus-z:10:0:0:0:0:234.5:-24:538.33 \
		--rigid-marker pl-hit0-bottom:1:0:0:0:0:0:-30:0 \
		--rigid-marker pl-hit0-top:1:0:0:0:0:0:70:0 \
		--rigid-marker pl-hit1-bottom:2:0:0:0:0:0:0:0 \
		--rigid-marker pl-hit1-top:2:0:0:0:0:0:130:0 \
		--rigid-marker pl-hit2-bottom:4:0:0:0:0:0:0:0 \
		--rigid-marker pl-hit2-top:4:0:0:0:0:0:80:0 \
		--rigid-marker pl-hit3-bottom:18:0:0:0:0:-20:-300:0 \
		--rigid-marker pl-hit3-top:18:0:0:0:0:-20:0:0 \
		--rigid-marker pl-hit4-bottom:22:0:0:0:0:20:-300:0 \
		--rigid-marker pl-hit4-top:22:0:0:0:0:20:0:0 \
		--clip idle:wep02.drs:7 --clip walk:wep02.drs:13 \
		--clip aim-positive:wep02.drs:38:16 --clip aim-level:wep02.drs:39 \
		--clip aim-negative:wep02.drs:40:16 \
		--clip fire-positive:wep02.drs:41:16 --clip fire-level:wep02.drs:42 \
		--clip fire-negative:wep02.drs:43:16 \
		--clip reload:wep02.drs:45 --clip hit-left:pl00.drs:70 \
		--clip death:pl00.drs:72 \
		--sample-step $(CHARACTER_SAMPLE_STEP) --cluster-mm $(CHARACTER_CLUSTER_MM) \
		--quantum-mm 0.125 \
		$(CHARACTER_TEXTURE_MAX_ARG) \
		--output $(LEON_CHARACTER)

character-ganado:
	$(PYTHON) tools/convert_character.py --source $(RE4_DISC) \
		--cache-dir build/private/disc-cache --model-archive em12.drs --model-entry 440 \
		--attachment head:em12.drs:442:441 \
		--attachment right-hand:em12.drs:447:441 \
		--attachment left-hand:em12.drs:452:441 \
		--rigid-attachment hatchet:em12.drs:616:617:10:-313.85:-21.2:102.21:-1.0402162 \
		--rigid-marker em-hit0-bottom:4:0:0:0:0:0:0:0 \
		--rigid-marker em-hit0-top:4:0:0:0:0:0:110:0 \
		--rigid-marker em-hit1-bottom:1:0:0:0:0:0:-30:0 \
		--rigid-marker em-hit1-top:1:0:0:0:0:0:260:0 \
		--rigid-marker em-hit2-bottom:19:0:0:0:0:-20:-400:0 \
		--rigid-marker em-hit2-top:19:0:0:0:0:-20:0:0 \
		--rigid-marker em-hit3-bottom:23:0:0:0:0:20:-400:0 \
		--rigid-marker em-hit3-top:23:0:0:0:0:20:0:0 \
		--rigid-marker em-hit4-bottom:8:0:0:0:0:-350:0:0 \
		--rigid-marker em-hit4-top:8:0:0:0:0:0:0:0 \
		--rigid-marker em-hit5-bottom:14:0:0:0:0:0:0:0 \
		--rigid-marker em-hit5-top:14:0:0:0:0:350:0:0 \
		--rigid-marker em-hit6-bottom:18:0:0:0:0:-20:-300:0 \
		--rigid-marker em-hit6-top:18:0:0:0:0:-20:0:0 \
		--rigid-marker em-hit7-bottom:22:0:0:0:0:20:-300:0 \
		--rigid-marker em-hit7-top:22:0:0:0:0:20:0:0 \
		--rigid-marker em-hit8-bottom:7:0:0:0:0:-300:0:0 \
		--rigid-marker em-hit8-top:7:0:0:0:0:0:0:0 \
		--rigid-marker em-hit9-bottom:13:0:0:0:0:0:0:0 \
		--rigid-marker em-hit9-top:13:0:0:0:0:300:0:0 \
		--rigid-marker axe-base:10:-313.85:-21.2:102.21:-1.0402162:0:0:-1000 \
		--rigid-marker axe-low:10:-313.85:-21.2:102.21:-1.0402162:0:0:-200 \
		--rigid-marker axe-high:10:-313.85:-21.2:102.21:-1.0402162:0:0:50 \
		--clip idle:em12.drs:1 --clip walk:em12.drs:4 \
		--clip attack:em12.drs:128 --clip hit:em12.drs:38 \
		--clip death:em12.drs:103 --sample-step 2 \
		--cluster-mm $(CHARACTER_CLUSTER_MM) --quantum-mm 0.125 \
		$(CHARACTER_TEXTURE_MAX_ARG) \
		--output $(GANADO_CHARACTER)

source-weapon-audio:
	@mkdir -p $(SOURCE_AUDIO_DIR)
	$(DTK) vfs cp $(RE4_DISC):/files/em/wep02.drs $(SOURCE_AUDIO_DIR)/wep02.drs
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_AUDIO_DIR)/wep02.drs 0 $(SOURCE_AUDIO_DIR)/wep02-cue00.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_AUDIO_DIR)/wep02.drs 2 $(SOURCE_AUDIO_DIR)/wep02-cue02.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_AUDIO_DIR)/wep02.drs 0x16 $(SOURCE_AUDIO_DIR)/wep02-cue16.wav

source-enemy-audio:
	@mkdir -p $(SOURCE_ENEMY_AUDIO_DIR)
	$(DTK) vfs cp $(RE4_DISC):/files/em/em12.drs $(SOURCE_ENEMY_AUDIO_DIR)/em12.drs
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_ENEMY_AUDIO_DIR)/em12.drs 0x3d $(SOURCE_ENEMY_AUDIO_DIR)/em12-cue3d.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_ENEMY_AUDIO_DIR)/em12.drs 0x0c $(SOURCE_ENEMY_AUDIO_DIR)/em12-body-hit-0c.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_ENEMY_AUDIO_DIR)/em12.drs 0x47 $(SOURCE_ENEMY_AUDIO_DIR)/em12-damage-voice-47.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_ENEMY_AUDIO_DIR)/em12.drs 0x16 $(SOURCE_ENEMY_AUDIO_DIR)/em12-death-voice-16.wav

source-player-audio:
	@mkdir -p $(SOURCE_PLAYER_AUDIO_DIR)
	$(DTK) vfs cp $(RE4_DISC):/files/em/pl00.drs $(SOURCE_PLAYER_AUDIO_DIR)/pl00.drs
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_PLAYER_AUDIO_DIR)/pl00.drs 9 $(SOURCE_PLAYER_AUDIO_DIR)/pl00-cue09.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_PLAYER_AUDIO_DIR)/pl00.drs 10 $(SOURCE_PLAYER_AUDIO_DIR)/pl00-cue10.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_PLAYER_AUDIO_DIR)/pl00.drs 11 $(SOURCE_PLAYER_AUDIO_DIR)/pl00-cue11.wav
	$(PYTHON) tools/extract_drs_audio.py $(SOURCE_PLAYER_AUDIO_DIR)/pl00.drs 13 $(SOURCE_PLAYER_AUDIO_DIR)/pl00-cue13.wav

demo-r10d: room-r10d texture-r10d character-leon character-ganado source-weapon-audio source-enemy-audio source-player-audio

script-check:
	bash -n kos-env.sh tools/bootstrap_kos.sh

test: all audit motion-host motion-cross-host script-check unit
	$(BUILD)/abi_probe > $(BUILD)/abi-probe.json
	@printf 'Host baseline written to %s\n' '$(BUILD)'

clean:
	rm -rf $(BUILD)
