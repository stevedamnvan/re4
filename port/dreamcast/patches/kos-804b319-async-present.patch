+/* Non-blocking presentation for a manual-flip owner (RE4DC D367 pipeline).
+   Record the late present/discard decision for the scene just finished; it
+   applies as soon as that scene's render completes (at once if it already
+   has). present: the next vblank flips it. discard: the completed buffer is
+   dropped and a queued (double-buffered) scene may start rendering. Returns
+   -1 outside manual mode or while the previous decision is still pending
+   (call pvr_present_wait() first). */
+static int pvr_pending_decision = -1;
+
+static void pvr_apply_decision(int present) {
+    if(present) {
+        pvr_flip_allowed = true;
+    }
+    else {
+        pvr_state.render_completed = 0;
+        genwait_wake_all((void *)&pvr_state.render_completed);
+        /* From thread context the next vblank starts a queued scene. */
+        if(irq_inside_int())
+            pvr_render_lists();
+    }
+}
+
+int pvr_present_async(bool present) {
+    irq_disable_scoped();
+    if(!pvr_manual_flip || !pvr_state.valid || pvr_pending_decision >= 0 ||
+       pvr_flip_allowed)
+        return -1;
+    if(pvr_state.render_completed && !pvr_state.render_busy)
+        pvr_apply_decision(present);
+    else
+        pvr_pending_decision = present;
+    return 0;
+}
+
+int pvr_present_pending(void) {
+    return pvr_pending_decision >= 0 || pvr_flip_allowed;
+}
+
+/* Block until the last pvr_present_async() decision took effect (flipped or
+   discarded); that scene's render is then complete. */
+int pvr_present_wait(void) {
+    irq_disable_scoped();
+    while(pvr_pending_decision >= 0 || pvr_flip_allowed) {
+        if(genwait_wait((void *)&pvr_state.render_completed,
+                        "PVR present wait", 100) < 0)
+            return -1;
+    }
+    return 0;
+}
