@@ -16,6 +16,44 @@
 
 #include <stdio.h>
 
+/* Optional explicit presentation for a single scene owner. The default API
+   keeps automatic vblank flips. In manual mode a completed back buffer stays
+   hidden until its owner resolves it, after TA/render fences have completed. */
+static bool pvr_manual_flip;
+static bool pvr_flip_allowed;
+
+int pvr_set_manual_flip(bool enabled) {
+    irq_disable_scoped();
+    if(!pvr_state.valid || pvr_state.ta_busy || pvr_state.render_busy ||
+       pvr_state.render_completed)
+        return -1;
+    pvr_manual_flip = enabled;
+    pvr_flip_allowed = false;
+    return 0;
+}
+
+int pvr_resolve_frame(bool present) {
+    int result = 0;
+    irq_disable_scoped();
+    if(!pvr_manual_flip || !pvr_state.valid || pvr_state.ta_busy ||
+       pvr_state.render_busy || !pvr_state.render_completed)
+        return -1;
+    if(present) {
+        pvr_flip_allowed = true;
+        result = genwait_wait((void *)&pvr_state.render_completed,
+                              "PVR manual present", 100);
+        if(result < 0 && pvr_state.render_completed) {
+            pvr_flip_allowed = false; /* timed out: remain hidden, allow retry */
+            return -1;
+        }
+    }
+    else {
+        /* Retain the displayed buffer; the same back buffer can be reused. */
+        pvr_state.render_completed = 0;
+    }
+    return 0;
+}
+
